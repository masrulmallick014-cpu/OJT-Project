{
  "expo": {
    "name": "PulseCorp",
    "slug": "pulsecorp-wellness",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "pulsecorp",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.pulsecorp.wellness",
      "infoPlist": {
        "NSHealthShareUsageDescription": "PulseCorp reads your optional Apple Health data (Steps, Active Energy, Heart Rate, and Sleep) only when you enable health access to show your personal daily progress.",
        "NSHealthUpdateUsageDescription": "PulseCorp logs optional mindfulness and workout sessions you choose to record."
      },
      "entitlements": {
        "com.apple.developer.healthkit": true,
        "com.apple.developer.healthkit.access": []
      }
    },
    "android": {
      "package": "com.pulsecorp.wellness",
      "versionCode": 1,
      "permissions": [
        "android.permission.VIBRATE",
        "android.permission.ACTIVITY_RECOGNITION",
        "android.permission.health.READ_STEPS",
        "android.permission.health.READ_ACTIVE_CALORIES_BURNED",
        "android.permission.health.READ_HEART_RATE",
        "android.permission.health.READ_SLEEP"
      ],
      "intentFilters": [
        {
          "action": "androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE",
          "category": [
            "android.intent.category.DEFAULT"
          ]
        },
        {
          "action": "android.permission.health.START_ONBOARDING",
          "category": [
            "android.intent.category.DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "bundler": "metro",
      "backgroundColor": "#FAF8F3"
    },
    "plugins": [
      "./plugins/withHealthConnectRationale.js"
    ]
  }
}
