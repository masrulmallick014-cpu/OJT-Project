# PulseCorp Environment Configuration Template
# Copy this file to `.env` and fill in your project values.
# NEVER commit `.env` or any service-role / private signing keys to version control.

# Environment: development | staging | production
EXPO_PUBLIC_APP_ENV=development

# Supabase Project URL and Public Anonymous Key (Client-safe with RLS enabled)
# WARNING: Never place a Supabase `service_role` key in an EXPO_PUBLIC_ variable.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Optional Android Release Upload Keystore (Used by android/app/build.gradle for release builds)
PULSECORP_UPLOAD_STORE_FILE=
PULSECORP_UPLOAD_STORE_PASSWORD=
PULSECORP_UPLOAD_KEY_ALIAS=
PULSECORP_UPLOAD_KEY_PASSWORD=
